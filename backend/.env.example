# =========================================
# SkillSync Backend — Environment Variables
# =========================================
# Rename this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────
# Option 1 — Local MongoDB
# MONGO_URI=mongodb://localhost:27017/skillsync
#
# Option 2 — MongoDB Atlas (recommended for development)
# Replace <username>, <password>, <cluster>, <dbname> with your values.
MONGO_URI=mongodb+srv://aswanth18:aswanth1218@cluster0.xxxxxx.mongodb.net/SkillSyncDB?retryWrites=true&w=majority
# ─── JWT ──────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
